# Copy to `.env` and fill in. Never commit `.env`.
#
# Local infra is brought up by `docker compose up -d` at repo root.

# ─── Postgres ─────────────────────────────────────────────────────
DATABASE_URL=postgres://mmo:mmo@localhost:5432/mmo
TEST_DATABASE_URL=postgres://mmo:mmo@localhost:5432/mmo_test

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# ─── Gateway ──────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ─── Session ──────────────────────────────────────────────────────
SESSION_TTL_SECONDS=2592000     # 30 days

# ─── Discord OAuth (S01 #3 HITL) ──────────────────────────────────
# Register an app at https://discord.com/developers/applications
# Set the OAuth2 redirect URI to <GATEWAY_PUBLIC_URL>/auth/discord/callback
# Required scopes: identify
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/auth/discord/callback
GATEWAY_PUBLIC_URL=http://localhost:8080

# ─── Password hashing (lower in tests for speed) ──────────────────
BCRYPT_ROUNDS=12
